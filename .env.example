# ── Huawei Cloud credentials ──────────────────────────────────────────────────
HW_ACCESS_KEY=<your-hw-access-key>
HW_SECRET_KEY=<your-hw-secret-key>
HW_REGION=ap-southeast-1
HW_PROJECT_ID=<your-project-id>

# ── Single demo password (TaurusDB + nginx basic auth + JWT seed) ─────────────
# Used for: TaurusDB demouser password, nginx admin password, JWT secret seed
DEMO_PASSWORD=YOUR_DEMO_PASSWORD

# ── MaaS AI (Huawei Cloud Model as a Service) ─────────────────────────────────
MAAS_API_KEY=<your-maas-api-key>
MAAS_BASE_URL=https://api-ap-southeast-1.modelarts-maas.com/openai/v1
MAAS_MODEL=glm-5.1

# ── SSH key for Ansible access to demo runner ECS ─────────────────────────────
SSH_KEY_PATH=~/.ssh/taurus_demo_key

# ── Auto-filled by scripts/gen_inventory.py after terraform apply ─────────────
# Do not edit these manually — overwritten on every 'make up'
TAURUS_HOST=
TAURUS_PORT=3306
TAURUS_DB=fintech_demo
TAURUS_USER=demouser
TAURUS_INSTANCE_ID=
DEMO_RUNNER_IP=
