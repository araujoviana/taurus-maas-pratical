#!/bin/sh
# Blocks pushes that add credentials or sensitive files.
# Installed via `make hooks` (sets core.hooksPath to .githooks).
#
# Reads "<local_ref> <local_sha> <remote_ref> <remote_sha>" lines from stdin
# (the standard pre-push protocol) and scans every commit being pushed.
repo_root=$(git rev-parse --show-toplevel) || exit 1
zero="0000000000000000000000000000000000000000"
empty_tree=$(git hash-object -t tree /dev/null)
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a remote ref, nothing to scan

  if [ "$remote_sha" = "$zero" ]; then
    range="$empty_tree..$local_sha" # new branch: scan everything being introduced
  else
    range="$remote_sha..$local_sha"
  fi

  if ! git diff "$range" | python3 "$repo_root/.githooks/check_secrets.py"; then
    status=1
  fi
done

exit $status
